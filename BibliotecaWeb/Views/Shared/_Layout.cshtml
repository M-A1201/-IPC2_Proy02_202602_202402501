<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Gestión de Biblioteca</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background: linear-gradient(rgba(0, 0, 0, 0.8), rgba(0, 0, 0, 0.8)), url('/images/fondo-biblioteca.avif') no-repeat center center fixed;
            background-size: cover;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            color: #fff;
            min-height: 100vh;
        }
        .navbar-brand { font-weight: 700; color: #ffbc0d !important; }
        /* Tarjetas con fondo blanco sólido y texto oscuro para garantizar legibilidad perfecta */
        .card-custom { border: none; border-radius: 15px; box-shadow: 0 8px 25px rgba(0,0,0,0.5); background-color: #ffffff !important; color: #212529 !important; }
        .card-custom * { color: #212529; }
        .btn-custom { background-color: #da291c; color: white; font-weight: 600; border-radius: 8px; }
        .btn-custom:hover { background-color: #b71c1c; color: white; }
        .offcanvas { background-color: #1a1a1a !important; color: white; }
        .offcanvas .nav-link:hover { background-color: rgba(255,255,255,0.1); border-radius: 5px; }
    </style>
</head>
<body>
    <!-- Barra Superior -->
    <nav class="navbar navbar-dark bg-dark shadow-sm px-4">
        <a class="navbar-brand" href="@Url.Action("Index", "Home")">
            <i class="fa-solid fa-book-open-reader me-2 text-warning"></i> Sistema de Gestión de Biblioteca
        </a>
        
        <!-- Botón de las 3 rayitas -->
        <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#menuLateral">
            <span class="navbar-toggler-icon"></span>
        </button>
    </nav>

    <!-- Menú Lateral Desplegable con las 11 Opciones del Menú de Consola -->
    <div class="offcanvas offcanvas-end text-bg-dark" tabindex="-1" id="menuLateral">
        <div class="offcanvas-header border-bottom border-secondary">
            <h5 class="offcanvas-title text-warning"><i class="fa-solid fa-bars me-2"></i> Menú Principal</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body">
            <ul class="navbar-nav fs-6">
<!-- Cambia la línea que dice: Cargar datos desde archivo XML -->
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("CargarXml", "Home")"><i class="fa-solid fa-file-import me-2 text-warning"></i> 1. Cargar datos desde archivo XML</a></li>                
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("Registrar", "Biblioteca")"><i class="fa-solid fa-book-medical me-2 text-warning"></i> 2. Registrar nuevo libro en catálogo</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("Buscar", "Biblioteca")"><i class="fa-solid fa-magnifying-glass me-2 text-warning"></i> 3. Buscar libro por ISBN</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("Estructura", "Home")"><i class="fa-solid fa-folder-tree me-2 text-warning"></i> 4. Mostrar estructura completa</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("Subcategoria", "Biblioteca")"><i class="fa-solid fa-sitemap me-2 text-warning"></i> 5. Organización desde subcategoría</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("Identificar", "Biblioteca")"><i class="fa-solid fa-list-check me-2 text-warning"></i> 6. Libros de una categoría</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("ExtremosIsbn", "Biblioteca")"><i class="fa-solid fa-arrow-up-wide-short me-2 text-warning"></i> 7. Menor y mayor ISBN</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("Eliminar", "Biblioteca")"><i class="fa-solid fa-trash-can me-2 text-warning"></i> 8. Eliminar libro del catálogo</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("Reportes", "Biblioteca")"><i class="fa-solid fa-diagram-project me-2 text-warning"></i> 9. Generar reportes Graphviz</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-white" href="@Url.Action("Ayuda", "Home")"><i class="fa-solid fa-circle-info me-2 text-warning"></i> 10. Ayuda</a></li>
                <li class="nav-item mb-1"><a class="nav-link text-danger" href="@Url.Action("Index", "Home")"><i class="fa-solid fa-right-from-bracket me-2"></i> 11. Salir</a></li>
            </ul>
        </div>
    </div>

    <!-- Contenido Principal -->
    <div class="container my-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>