@{
    ViewData["Title"] = "1. Cargar datos desde archivo XML";
}

<div class="row justify-content-center align-items-center" style="min-height: 75vh;">
    <div class="col-md-9 col-lg-8">
        <div class="card card-custom p-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="fw-bold text-dark m-0">
                    <i class="fa-solid fa-file-import text-danger me-2"></i> 1. Cargar Datos desde Archivo XML
                </h2>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Volver
                </a>
            </div>
            <hr />

            @if (TempData["Mensaje"] != null)
            {
                var tipo = TempData["TipoAlerta"] ?? "success";
                <div class="alert alert-@tipo alert-dismissible fade show shadow-sm" role="alert">
                    @TempData["Mensaje"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form method="post" enctype="multipart/form-data" class="border p-4 rounded-4 bg-light shadow-sm mt-3">
                <label class="form-label fw-bold mb-3 text-dark">
                    <i class="fa-solid fa-file-code text-danger me-2"></i> Selecciona tu archivo XML de entrada
                </label>
                <div class="input-group">
                    <input type="file" name="archivoXml" class="form-control" accept=".xml" required />
                    <button type="submit" class="btn btn-custom px-4">
                        <i class="fa-solid fa-upload me-2"></i> Procesar Datos
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>