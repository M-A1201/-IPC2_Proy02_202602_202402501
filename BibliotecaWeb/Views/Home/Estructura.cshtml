@model Proyecto2.Categoria
@using Proyecto2

@{
    ViewData["Title"] = "Estructura de la Biblioteca";
}

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card card-custom p-4 shadow-sm" style="background-color: #ffffff; color: #212529;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="fw-bold text-dark m-0"><i class="fa-solid fa-folder-tree me-2 text-danger"></i> Estructura de Categorías y Libros</h2>
                <a href="@Url.Action("Index", "Home")" class="btn btn-outline-dark btn-sm">
                    <i class="fa-solid fa-arrow-left me-1"></i> Volver al Menú Principal
                </a>
            </div>
            <hr />

            @if (Model == null)
            {
                <div class="alert alert-danger" role="alert">
                    No hay datos cargados. Carga un archivo XML primero desde el menú principal.
                </div>
            }
            else
            {
                <div style="background-color: #f8f9fa; padding: 20px; border-radius: 8px; font-family: monospace; color: #212529; border: 1px solid #dee2e6;">
                    @{
                        RenderizarArbol(Model);
                    }
                </div>
            }
        </div>
    </div>
</div>

@{
    void RenderizarArbol(Categoria cat)
    {
        if (cat == null)
            return;

        <ul style="list-style-type: none; padding-left: 20px;">
            <li class="my-2">
                <span style="font-size: 1.1em; color: #0d6efd; font-weight: bold;">
                    <i class="fa-solid fa-folder-open me-1"></i> Categoría: @cat.GetNombre()
                </span>

                @{
                    NodoLibro nodoLibro = cat.GetPrimerLibro();
                    if (nodoLibro != null)
                    {
                        <ul style="list-style-type: disc; margin-top: 5px;">
                            @while (nodoLibro != null)
                            {
                                Libro libro = nodoLibro.Libro;
                                <li class="my-1 text-dark">
                                    <span class="badge bg-secondary">ISBN: @libro.ISBN</span>
                                    <strong class="text-dark">@libro.Titulo</strong> 
                                    <span class="text-muted">- @libro.NombreAutor</span>
                                </li>
                                nodoLibro = nodoLibro.GetSiguiente();
                            }
                        </ul>
                    }
                    else
                    {
                        <ul style="list-style-type: none; margin-top: 5px;">
                            <li><span style="color: #6c757d; font-style: italic;">(Sin libros en esta categoría)</span></li>
                        </ul>
                    }
                }

                @{
                    Categoria.NodoSubCategoria nodoSub = cat.GetPrimerSubCategoria();
                    while (nodoSub != null)
                    {
                        RenderizarArbol(nodoSub.GetCategoria());
                        nodoSub = nodoSub.GetSiguiente();
                    }
                }
            </li>
        </ul>
    }
}